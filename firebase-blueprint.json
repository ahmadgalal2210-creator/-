  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private owner profile document."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectFolder" },
      "description": "User project folders across company operations."
    },
    "/users/{userId}/files/{fileId}": {
      "schema": { "$ref": "#/entities/IndexedFile" },
      "description": "Indexed Word, Excel, PDF, and document metadata + extracted search content."
    },
    "/users/{userId}/images/{imageId}": {
      "schema": { "$ref": "#/entities/IndexedImage" },
      "description": "Indexed images and visual archive records."
    },
    "/users/{userId}/memos/{memoId}": {
      "schema": { "$ref": "#/entities/WorkMemo" },
      "description": "Factory incoming and outgoing memos."
    },
    "/users/{userId}/drafts/{draftId}": {
      "schema": { "$ref": "#/entities/WorkDraft" },
      "description": "A4 Word drafts and voice-dictated notepads (المفكرات والمسودات)."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/WorkOrder" },
      "description": "Actionable business memos (مذكرة الأعمال) and assignments."
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/IncomingMessage" },
      "description": "Incoming messages triaged into memos or business memos."
    },
    "/users/{userId}/correspondenceEntities/{entityId}": {
      "schema": { "$ref": "#/entities/CorrespondenceEntity" },
      "description": "External authorities and correspondence partner entities."
    },
    "/users/{userId}/correspondences/{correspondenceId}": {
      "schema": { "$ref": "#/entities/ExternalCorrespondence" },
      "description": "Incoming and outgoing external correspondences grouped by entity."
    }
  }
}
